GAINLAB_ENV=production
GAINLAB_HOST=127.0.0.1
GAINLAB_PORT=8800

# sqlite | mysql
GAINLAB_DATABASE_TYPE=mysql

# Used only when GAINLAB_DATABASE_TYPE=sqlite
GAINLAB_DATABASE_PATH=runtime/gainlab_ai.db

# Used only when GAINLAB_DATABASE_TYPE=mysql
GAINLAB_MYSQL_HOST=127.0.0.1
GAINLAB_MYSQL_PORT=3306
GAINLAB_MYSQL_DATABASE=gainlab_ai_trading
GAINLAB_MYSQL_USER=gainlab_ai_trading
GAINLAB_MYSQL_PASSWORD=change-me

GAINLAB_AUTH_SECRET=replace-with-a-long-random-secret
# Must match the Node admin service JWT_SECRET.
GAINLAB_ADMIN_JWT_SECRET=replace-with-the-node-admin-jwt-secret
GAINLAB_SESSION_DAYS=30
GAINLAB_VERIFICATION_MINUTES=10

GAINLAB_MAIL_HOST=smtp.example.com
GAINLAB_MAIL_PORT=465
GAINLAB_MAIL_USER=no-reply@example.com
GAINLAB_MAIL_PASSWORD=change-me
GAINLAB_MAIL_FROM=no-reply@example.com
GAINLAB_MAIL_SECURE=true
